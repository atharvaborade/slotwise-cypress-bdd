# This workflow is intentionally disabled because the repository currently uses local execution.
# Rename this file to cypress-bdd.yml when you want GitHub Actions to run it manually.
# It uses workflow_dispatch only, so pushes and pull requests do not start runners.

name: Cypress BDD quality checks

on:
  workflow_dispatch:

jobs:
  cypress-bdd:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Check out repository
        uses: actions/checkout@v4
      - name: Use Node.js 24
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - name: Install dependencies
        run: npm ci
      - name: Run Cypress BDD scenarios
        run: npm test
      - name: Generate Cucumber HTML report
        if: always()
        run: npm run report
      - name: Upload evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: slotwise-cypress-evidence
          path: |
            cypress/reports
            cypress/screenshots
            cypress/videos
          if-no-files-found: warn

